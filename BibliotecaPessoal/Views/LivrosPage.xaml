<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BibliotecaPessoal.Views.LivrosPage"
             Title="Livros"
             BackgroundColor="#F5F1E8">
    <Grid Padding="18" RowDefinitions="Auto,Auto,*" RowSpacing="12">
        <SearchBar Grid.Row="0" Placeholder="Buscar por título ou autor" Text="{Binding Pesquisa}" />
        <Button Grid.Row="1" Text="＋ Adicionar livro" Command="{Binding AdicionarCommand}" />
        <CollectionView Grid.Row="2" ItemsSource="{Binding Livros}" EmptyView="Nenhum livro cadastrado.">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,4" Padding="12" BackgroundColor="White" Stroke="#E2D9C8" StrokeShape="RoundRectangle 14">
                        <Grid ColumnDefinitions="62,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12">
                            <Image Grid.RowSpan="4" Source="{Binding Capa}" HeightRequest="82" WidthRequest="58" Aspect="AspectFill" />
                            <Label Grid.Column="1" Text="{Binding Titulo}" FontAttributes="Bold" FontSize="17" TextColor="#18324B" LineBreakMode="TailTruncation" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding Autor}" TextColor="#607080" LineBreakMode="TailTruncation" />
                            <Label Grid.Row="2" Grid.Column="1" Text="{Binding AnoPublicacao, StringFormat='Ano: {0}'}" TextColor="#607080" />
                            <Label Grid.Row="3" Grid.Column="1" Text="{Binding Formato}" TextColor="#607080" />
                            <HorizontalStackLayout Grid.Column="2" Grid.RowSpan="4" Spacing="4" VerticalOptions="Center">
                                <Button Text="Editar" Padding="8,5" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditarCommand}" CommandParameter="{Binding .}" />
                                <Button Text="Excluir" Padding="8,5" BackgroundColor="#A74343" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ExcluirCommand}" CommandParameter="{Binding .}" />
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
