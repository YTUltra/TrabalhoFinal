<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BibliotecaPessoal.Views.CategoriaFormPage"
             Title="Categoria"
             BackgroundColor="#F5F1E8">
    <ScrollView>
        <VerticalStackLayout Padding="22" Spacing="14">
            <Label x:Name="TituloPagina" Text="Nova categoria" FontSize="26" FontAttributes="Bold" TextColor="#18324B" />
            <Entry x:Name="NomeEntry" Placeholder="Nome (até 40 caracteres)" MaxLength="40" />
            <Editor x:Name="DescricaoEditor" Placeholder="Descrição (opcional)" MaxLength="120" AutoSize="TextChanges" />
            <Button Text="Salvar categoria" Clicked="SalvarClicked" />
            <Button Text="Cancelar" Clicked="CancelarClicked" BackgroundColor="#607080" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
