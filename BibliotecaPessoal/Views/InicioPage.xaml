<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BibliotecaPessoal.Views.InicioPage"
             Title="Início"
             BackgroundColor="#F5F1E8">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">
            <Label Text="Minha Biblioteca" FontSize="30" FontAttributes="Bold" TextColor="#18324B" />
            <Label Text="Seus livros, organizados do seu jeito." FontSize="16" TextColor="#607080" />
            <Border BackgroundColor="#18324B" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="18">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Resumo da coleção" FontSize="16" TextColor="#D9E3EA" />
                    <Label Text="{Binding Resumo}" FontSize="20" FontAttributes="Bold" TextColor="White" />
                    <Button Text="Atualizar resumo" Command="{Binding AtualizarCommand}" BackgroundColor="#D9995B" TextColor="#18324B" />
                </VerticalStackLayout>
            </Border>
            <Label Text="Acessos rápidos" FontSize="20" FontAttributes="Bold" TextColor="#18324B" />
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                <Button Grid.Row="0" Grid.Column="0" Text="Meus livros" Command="{Binding AbrirLivrosCommand}" />
                <Button Grid.Row="0" Grid.Column="1" Text="Categorias" Command="{Binding AbrirCategoriasCommand}" />
                <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="Empréstimos" Command="{Binding AbrirEmprestimosCommand}" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
