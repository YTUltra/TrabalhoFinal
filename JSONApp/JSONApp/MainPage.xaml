<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JSONApp.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Margin="10"
            Spacing="10"
            HorizontalOptions="Center">
            <Label Text="Demonstração de JSON" FontSize="Large" FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <Button x:Name="btPage1" Text="Exemplo 1" HorizontalOptions="Fill" Clicked="btPage1_Clicked"/>
            
            <Button x:Name="btPage2" Text="Exemplo 2" HorizontalOptions="Fill" Clicked="btPage2_Clicked"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
